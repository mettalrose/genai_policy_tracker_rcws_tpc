type: dataset
title: "AI Policy Tracker for Journals in RCWS and TPC"
authors:
  - family-names: "Gupta"
    given-names: "Anuj"
  - family-names: "Miller-Cochran"
    given-names: "Susan"
  - family-names: "Anson"
